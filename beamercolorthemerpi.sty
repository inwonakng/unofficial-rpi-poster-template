% RPI poster color theme
% Based on https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% Colors from
% https://scer.rpi.edu/brand-in-action/colors

\definecolor{rpi_black}{RGB}{0, 0, 0}
\definecolor{rpi_red}{RGB}{214, 0, 29}
\definecolor{rpi_darkgray}{RGB}{84, 88, 90}
\definecolor{rpi_lightgray}{RGB}{158, 162, 162}



% Extra colors
\definecolor{lightgray}{RGB}{240, 240, 240}
\definecolor{rpi_alert_tint}{RGB}{255, 246, 245}
\definecolor{rpi_alert_rule}{RGB}{178, 0, 24}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=rpi_black}
\setbeamercolor{background canvas}{bg=rpi_black}


% Headline
\setbeamercolor{headline}{fg=white,bg=rpi_black}

% Block
\setbeamercolor{block title}{fg=white,bg=rpi_black}
\setbeamercolor{block separator}{bg=rpi_darkgray}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=white,bg=rpi_red}
\setbeamercolor{block alerted separator}{bg=rpi_alert_rule}
\setbeamercolor{block alerted body}{fg=black,bg=rpi_alert_tint}

% Example Block
\setbeamercolor{block example title}{fg=white,bg=rpi_darkgray}
\setbeamercolor{block example separator}{bg=rpi_darkgray}
\setbeamercolor{block example body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=rpi_black}

% Itemize
\setbeamercolor{item}{fg=rpi_black}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
