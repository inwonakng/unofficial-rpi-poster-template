% Heading
\newcommand\heading[1]
{%
  \par\bigskip
  {\usebeamerfont{heading}\usebeamercolor[fg]{heading}#1}\par\smallskip
}

\newlength{\blocksepheight}
\setlength{\blocksepheight}{2ex}
\newcommand{\blockseparator}{\par\vspace{\blocksepheight}}

\newlength{\rpiblockbodyxpad}
\setlength{\rpiblockbodyxpad}{16pt}
\newlength{\rpiblockbodybottompad}
\setlength{\rpiblockbodybottompad}{24pt}
\newcommand{\rpiblockbodysetup}{%
  \usebeamerfont{block body}%
  \justifying
  \setlength{\parskip}{1ex}%
}

% Poster row/column layout helpers.
% \pcolumnsepwidth controls the horizontal gap between adjacent \pcolumn environments.
% \begin{pframe} ... \end{pframe} wraps a beamer frame and adds the same gap at
% the left and right edges.
% \begin{prow} ... \end{prow} only adds gaps between adjacent columns, which is
% useful for nested rows inside a wider column.
\newlength{\pcolumnsepwidth}
\setlength{\pcolumnsepwidth}{0.025\paperwidth}
\NewDocumentEnvironment{prow}{O{0pt}}
{%
  \par\nointerlineskip\noindent%
  \begingroup%
  \setlength{\parindent}{0pt}%
  \leavevmode\hbox\bgroup%
  \hspace{#1}%
  \ignorespaces%
}
{%
  \unskip%
  \hspace{\dimexpr#1-\pcolumnsepwidth\relax}%
  \egroup%
  \endgroup%
  \par%
  \ignorespacesafterend%
}
\NewDocumentEnvironment{pframe}{O{t} +b}
{%
  \begin{frame}[#1]%
    \begin{prow}[\pcolumnsepwidth]%
      #2%
    \end{prow}%
  \end{frame}%
}
{}
\NewDocumentEnvironment{pcolumn}{m +b}
{%
  \begin{minipage}[t]{#1}%
    #2%
    \unskip%
  \end{minipage}%
  \hspace{\pcolumnsepwidth}%
  \ignorespacesafterend%
}
{}
\newif\ifrpipblockactive

% Minimum-height poster block.
% Usage: \begin{pblock}[<block type>]{<title>}{<total block height>} ... \end{pblock}
% The optional block type defaults to block and can be set to alert or example.
% If the contents need more than <total block height>, the block grows to avoid overprinting later content.
% pblock adds trailing vertical space; pcolumn removes the final trailing space in each column.
\newcommand{\rpipblockenvname}[1]{%
  \def\rpipblockenv{#1}%
  \ifstrequal{#1}{alert}{\def\rpipblockenv{alertblock}}{}%
  \ifstrequal{#1}{example}{\def\rpipblockenv{exampleblock}}{}%
}
\newsavebox{\rpipblockbodybox}
\newsavebox{\rpipblocktrialbox}
\newlength{\rpipblockbodyheight}
\newlength{\rpipblocktargetheight}
\newlength{\rpipblockbodytargetheight}
\newlength{\rpipblockbodywidth}
\newlength{\rpipblocktrialheight}
\newlength{\rpipblockextraheight}
\NewDocumentEnvironment{pblock}{O{block} m m +b}
{%
  \rpipblockenvname{#1}%
  \setlength{\rpipblocktargetheight}{#3}%
  \setlength{\rpipblockbodywidth}{\dimexpr\linewidth-\rpiblockbodyxpad-\rpiblockbodyxpad\relax}%
  \setbox\rpipblockbodybox=\vbox{%
    \hsize=\rpipblockbodywidth
    \linewidth=\hsize
    \columnwidth=\hsize
    \begin{minipage}[t]{\rpipblockbodywidth}%
      \rpiblockbodysetup
      #4%
    \end{minipage}%
  }%
  \setlength{\rpipblockbodyheight}{\dimexpr\ht\rpipblockbodybox+\dp\rpipblockbodybox\relax}%
  \setlength{\rpipblockbodytargetheight}{\rpipblockbodyheight}%
  \setbox\rpipblocktrialbox=\vbox{%
    \hsize=\linewidth
    \linewidth=\hsize
    \columnwidth=\hsize
    \global\rpipblockactivetrue
    \begin{\rpipblockenv}{#2}%
      \begin{minipage}[t][\rpipblockbodytargetheight][t]{\linewidth}%
        \noindent\copy\rpipblockbodybox
      \end{minipage}%
    \end{\rpipblockenv}%
    \global\rpipblockactivefalse
  }%
  \setlength{\rpipblocktrialheight}{\dimexpr\ht\rpipblocktrialbox+\dp\rpipblocktrialbox\relax}%
  \ifdim\rpipblocktrialheight<\rpipblocktargetheight
    \setlength{\rpipblockextraheight}{\dimexpr\rpipblocktargetheight-\rpipblocktrialheight\relax}%
    \addtolength{\rpipblockbodytargetheight}{\rpipblockextraheight}%
  \fi
  \setbox\rpipblocktrialbox=\vbox{%
    \hsize=\linewidth
    \linewidth=\hsize
    \columnwidth=\hsize
    \global\rpipblockactivetrue
    \begin{\rpipblockenv}{#2}%
      \begin{minipage}[t][\rpipblockbodytargetheight][t]{\linewidth}%
        \noindent\copy\rpipblockbodybox
      \end{minipage}%
    \end{\rpipblockenv}%
    \global\rpipblockactivefalse
  }%
  \setlength{\rpipblocktrialheight}{\dimexpr\ht\rpipblocktrialbox+\dp\rpipblocktrialbox\relax}%
  \ifdim\rpipblocktrialheight<\rpipblocktargetheight
    \setlength{\rpipblockextraheight}{\dimexpr\rpipblocktargetheight-\rpipblocktrialheight\relax}%
    \addtolength{\rpipblockbodytargetheight}{\rpipblockextraheight}%
  \fi
  \global\rpipblockactivetrue
  \begin{\rpipblockenv}{#2}%
    \begin{minipage}[t][\rpipblockbodytargetheight][t]{\linewidth}%
      \noindent\box\rpipblockbodybox
    \end{minipage}%
  \end{\rpipblockenv}%
  \global\rpipblockactivefalse
  \blockseparator%
}
{}

% logo
\newlength{\logoleftwidth}
\setlength{\logoleftwidth}{0cm}
\newlength{\logorightwidth}
\setlength{\logorightwidth}{0cm}
\newlength{\maxlogowidth}  % space on both sides set to maxlogowidth to keep title centered
\setlength{\maxlogowidth}{0cm}

\newcommand{\logoright}[1]{
  \newcommand{\insertlogoright}{#1}
  \settowidth{\logorightwidth}{\insertlogoright}
  \addtolength{\logorightwidth}{10ex}
  \setlength{\maxlogowidth}{\maxof{\logoleftwidth}{\logorightwidth}}
}
\newcommand{\logoleft}[1]{
  \newcommand{\insertlogoleft}{#1}
  \settowidth{\logoleftwidth}{\insertlogoleft}
  \addtolength{\logoleftwidth}{10ex}
  \setlength{\maxlogowidth}{\maxof{\logoleftwidth}{\logorightwidth}}
}

\newcommand{\rpitickerbar}[3][white]{%
  \begingroup
  \pgfmathsetlengthmacro{\rpitickerunit}{#2/36}%
  \begin{tikzpicture}[baseline]
    \path[use as bounding box] (0,0) rectangle (#3,#2);
    \clip (0,0) rectangle (#3,#2);
    \begin{scope}[x=\rpitickerunit,y=\rpitickerunit]
      \foreach \i in {0,...,250}{%
        \pgfmathsetmacro{\x}{28.159*\i}%
        \fill[#1] (\x,0) rectangle ++(7.148,18);
        \fill[#1] (\x+7.148,18) rectangle ++(7.148,18);
        \fill[#1] (\x+14.296,0) rectangle ++(7.148,36);
      }%
    \end{scope}
  \end{tikzpicture}%
  \endgroup
}

% Headline
\setbeamertemplate{headline}
{
  \begin{beamercolorbox}{headline}
    \begin{columns}
      \begin{column}{\maxlogowidth}
        \vskip5ex
        \ifdefined\insertlogoleft
        \vspace*{\fill}
        \hspace{10ex}
        \raggedright
        \insertlogoleft
        \vspace*{\fill}
        \else\fi
      \end{column}
      \begin{column}{\dimexpr\paperwidth-\maxlogowidth-\maxlogowidth}
        \usebeamerfont{headline}
        \vskip3ex
        \centering
        \ifx \inserttitle \empty \else
        {\usebeamerfont{headline title}\usebeamercolor[fg]{headline title}\inserttitle\\[0.5ex]}
        \fi
        \ifx \beamer@shortauthor \empty \else
        {\usebeamerfont{headline author}\usebeamercolor[fg]{headline author}\insertauthor\\[1ex]}
        \fi
        \ifx \insertinstitute \empty \else
        {\usebeamerfont{headline institute}\usebeamercolor[fg]{headline institute}\insertinstitute\\[1ex]}
        \fi
      \end{column}
      \begin{column}{\maxlogowidth}
        \vskip5ex
        \ifdefined\insertlogoright
        \vspace*{\fill}
        \raggedleft
        \insertlogoright
        \hspace{10ex}
        \vspace*{\fill}
        \else\fi
      \end{column}
    \end{columns}
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north east,inner sep=0pt]
        at (current page.north east)
        {\rotatebox{-90}{\rpitickerbar{0.8cm}{\paperheight}}};
    \end{tikzpicture}
    \vspace{5ex}
  \end{beamercolorbox}
}

\newsavebox{\rpiblockcontentbox}
\newsavebox{\rpiblocktitlebox}
\newlength{\rpiblockcontentheight}
\newlength{\rpiblocktitlewidth}
\newlength{\rpiblocktitleheight}
\newlength{\rpiblocktitlexpad}
\newlength{\rpiblocktitleypad}
\newlength{\rpiblocktitlebaseline}
\newlength{\rpiblocktotalheight}
\newlength{\rpiblockcornerradius}
\newlength{\rpiblockheaderradius}
\setlength{\rpiblockcornerradius}{8pt}
\setlength{\rpiblockheaderradius}{12pt}

\newcommand{\rpiblockcapturebegin}[1]{%
  \setbox\rpiblockcontentbox=\vbox\bgroup
    \hsize=\linewidth
    \linewidth=\hsize
    \columnwidth=\hsize
    \setlength{\parindent}{0pt}%
    \usebeamercolor[fg]{#1}%
}
\newcommand{\rpiblockcaptureend}{\egroup}

\newcommand{\rpirenderblock}[3]{%
  \begingroup
  \usebeamercolor{#2}%
  \colorlet{rpiblockbodybg}{bg}%
  \usebeamercolor{#1}%
  \colorlet{rpiblocktitlebg}{bg}%
  \colorlet{rpiblocktitlefg}{fg}%
  \usebeamerfont{block title}%
  \setlength{\rpiblocktitlexpad}{1.2ex}%
  \setlength{\rpiblocktitleypad}{0.75ex}%
  \setbox\rpiblocktitlebox=\hbox{\color{rpiblocktitlefg}\usebeamerfont{block title}#3}%
  \setlength{\rpiblocktitlewidth}{\dimexpr\wd\rpiblocktitlebox+2\rpiblocktitlexpad\relax}%
  \setlength{\rpiblocktitleheight}{\dimexpr\ht\rpiblocktitlebox+\dp\rpiblocktitlebox+2\rpiblocktitleypad\relax}%
  \setlength{\rpiblocktitlebaseline}{\dimexpr\rpiblocktitleypad+\ht\rpiblocktitlebox\relax}%
  \setlength{\rpiblockcontentheight}{\dimexpr\ht\rpiblockcontentbox+\dp\rpiblockcontentbox\relax}%
  \setlength{\rpiblocktotalheight}{\dimexpr\rpiblocktitleheight+\rpiblockcontentheight\relax}%
  \par\noindent
  \begin{tikzpicture}[baseline=(rpiblockbase.base)]
    \coordinate (rpiblockbase) at (0pt,\dimexpr-\rpiblocktotalheight\relax);
    \path[use as bounding box]
      (0pt,0pt) rectangle (\linewidth,\dimexpr-\rpiblocktotalheight\relax);
    \fill[rpiblockbodybg]
      (\rpiblocktitlewidth,0pt) --
      (\dimexpr\linewidth-\rpiblockcornerradius\relax,0pt)
      arc[start angle=90,end angle=0,radius=\rpiblockcornerradius] --
      (\linewidth,\dimexpr-\rpiblocktotalheight\relax) --
      (0pt,\dimexpr-\rpiblocktotalheight\relax) --
      (0pt,\dimexpr-\rpiblocktitleheight\relax) --
      (\dimexpr\rpiblocktitlewidth-\rpiblockheaderradius\relax,\dimexpr-\rpiblocktitleheight\relax)
      arc[start angle=-90,end angle=0,radius=\rpiblockheaderradius] -- cycle;
    \fill[rpiblocktitlebg]
      (0pt,0pt) -- (\rpiblocktitlewidth,0pt) --
      (\rpiblocktitlewidth,\dimexpr-\rpiblocktitleheight+\rpiblockheaderradius\relax)
      arc[start angle=0,end angle=-90,radius=\rpiblockheaderradius] --
      (0pt,\dimexpr-\rpiblocktitleheight\relax) -- cycle;
    \node[anchor=base west,inner sep=0pt,outer sep=0pt]
      at (\rpiblocktitlexpad,\dimexpr-\rpiblocktitlebaseline\relax)
      {\box\rpiblocktitlebox};
    \node[anchor=north west,inner sep=0pt,outer sep=0pt]
      at (0pt,\dimexpr-\rpiblocktitleheight\relax)
      {\box\rpiblockcontentbox};
  \end{tikzpicture}%
  \par
  \endgroup
}

% Block
\setbeamertemplate{block begin}
{
  \rpiblockcapturebegin{block body}
  \vskip1.25ex
  \noindent\hspace*{\rpiblockbodyxpad}\begin{minipage}{\dimexpr\linewidth-\rpiblockbodyxpad-\rpiblockbodyxpad\relax}
  \rpiblockbodysetup
}
\setbeamertemplate{block end}
{
  \end{minipage}
  \par\vspace{\rpiblockbodybottompad}
  \rpiblockcaptureend
  \rpirenderblock{block title}{block body}{\insertblocktitle}%
  \ifrpipblockactive\else\vspace*{\blocksepheight}\fi
}

% Alert Block
\setbeamertemplate{block alerted begin}
{
  \rpiblockcapturebegin{block alerted body}
  \vskip1.25ex
  \noindent\hspace*{\rpiblockbodyxpad}\begin{minipage}{\dimexpr\linewidth-\rpiblockbodyxpad-\rpiblockbodyxpad\relax}
  \rpiblockbodysetup
}
\setbeamertemplate{block alerted end}
{
  \end{minipage}
  \par\vspace{\rpiblockbodybottompad}
  \rpiblockcaptureend
  \rpirenderblock{block alerted title}{block alerted body}{\insertblocktitle}%
  \ifrpipblockactive\else\vspace*{\blocksepheight}\fi
}

% Example Block
\setbeamertemplate{block example begin}
{
  \rpiblockcapturebegin{block example body}
  \vskip1.25ex
  \noindent\hspace*{\rpiblockbodyxpad}\begin{minipage}{\dimexpr\linewidth-\rpiblockbodyxpad-\rpiblockbodyxpad\relax}
  \rpiblockbodysetup
}
\setbeamertemplate{block example end}
{
  \end{minipage}
  \par\vspace{\rpiblockbodybottompad}
  \rpiblockcaptureend
  \rpirenderblock{block example title}{block example body}{\insertblocktitle}%
  \ifrpipblockactive\else\vspace*{\blocksepheight}\fi
}

% Footer
\newcommand{\footercontent}[1]{\newcommand{\insertfootercontent}{#1}}

\setbeamertemplate{footline}{
  \ifdefined\insertfootercontent
  \begin{beamercolorbox}[vmode]{headline}
    \ifbeamercolorempty[bg]{headline rule}{}{
      \begin{beamercolorbox}[wd=\paperwidth,colsep=0.25ex]{headline rule}\end{beamercolorbox}
    }
    \vspace{1.5ex}
    \hspace{\pcolumnsepwidth}
    \usebeamerfont{footline}
    \centering
    \insertfootercontent
    \hspace{\pcolumnsepwidth}
    \vspace{1.5ex}
  \end{beamercolorbox}
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,inner sep=0pt]
      at (current page.north east)
      {\rotatebox{-90}{\rpitickerbar{0.8cm}{\paperheight}}};
  \end{tikzpicture}
  \else\fi
}
